<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SPARK</vendor>
  <action id="uk.ac.york.spark.pair">
    <description>Pair a phone with SPARK</description>
    <message>Pair a phone with SPARK (allowed from an active local session)</message>
    <!-- active local session can re-pair without sudo, single user machines only -->
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/spark-pair</annotate>
  </action>
</policyconfig>
