(*
 * Copyright (C) 2026 Archie Adams, Roberto Metere, University of York
 * SPDX-License-Identifier: Apache-2.0
 *
 * Secure Passwordless Authentication with Reveal-committed Knowledge
 *
 * SPARK-Authentication
 *
 *   1. V -> A : eph_V
 *   2. A -> V : eph_A
 *   3. V -> A : aead_K( sign_skV( "req"  || eph_V || eph_A || pk_V || pk_A ) )
 *               A decrypts, verifies, checks the pairing, and only then
 *               asks the user for biometric approval
 *   4. A -> V : aead_K( sign_skA( "resp" || eph_V || eph_A || pk_A || pk_V ) )
 *
 *   K = HKDF( ECDH(eph, eph'), info = eph_V || eph_A || pk_V || pk_A )
 *
 * Long-term keys are ECDSA P-256 inside the secure element; ephemerals are
 * X25519.  The ephemerals are the challenges, so there is no separate nonce,
 * session identifier or counter.  No identity travels on the wire: each
 * device takes the peer key from its trust store, and a wrong choice only
 * makes the exchange fail.
 *
 * Assume-guarantee.  This model assumes what SPARK-Pairing guarantees
 * (spark-setup.pv): trust stores contain only pairs of genuine device keys
 * that completed a pairing.  Honest devices are unboundedly many; the
 * adversary controls the network, chooses which honest devices are paired,
 * and may use keys of its own, but cannot enter an honest trust store.
 * The two phases composed are checked in spark-combined.pv.
 *
 * Forward secrecy.  In phase 1 every honest long-term key is given to the
 * adversary.  The name s is a probe for the session key K of a completed
 * login (data sent under K after the unlock), not a protocol message.
 *
 * Queries and expected outcomes: all true.
 *)

(* The untrusted network (Bluetooth / Wi-Fi) *)
free c: channel.

(* On the phone: the approval request shown to the user, and the user's
   biometric approval.  Two channels, so that the phone can never read back
   its own request as an approval. *)
free prompt: channel [private].
free approval: channel [private].

type skey.
type pkey.
type exponent.
type G.
type key.

(* ECDSA P-256 signatures *)
fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; verify(sign(m, k), pk(k), m) = true.
reduc forall m: bitstring, k: skey; getmess(sign(m, k)) = m.

(* X25519 ephemeral Diffie-Hellman *)
const g: G [data].
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).

(* HKDF-SHA-256; the second argument is the info field *)
fun kdf(G, bitstring): key.

(* AES-GCM under K *)
fun aead(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; aeadDec(aead(m, k), k) = m.

(* Domain-separation labels of the two signed messages *)
const lreq: bitstring.
const lresp: bitstring.

(* Honest devices, and the trust stores written by pairing *)
table idV(skey, pkey).
table idA(skey, pkey).
table trusted_V(pkey, pkey).   (* verifier's store: (own key, paired phone)    *)
table trusted_A(pkey, pkey).   (* phone's store:    (paired verifier, own key) *)

event paired(pkey, pkey).
event verifierStarted(pkey, pkey, G, G).
event authenticatorPrompted(pkey, pkey, G, G).
event userApproved(pkey, pkey, G, G).
event authenticatorFinished(pkey, pkey, G, G).
event verifierSuccess(pkey, pkey, G, G).

(* ============================ DEVICES ============================ *)

let RegisterV() =
  new sk_V: skey;
  let pk_V = pk(sk_V) in
  insert idV(sk_V, pk_V);
  out(c, pk_V).

let RegisterA() =
  new sk_A: skey;
  let pk_A = pk(sk_A) in
  insert idA(sk_A, pk_A);
  out(c, pk_A).

(* The guarantee of SPARK-Pairing, assumed here: only genuine device keys
   get paired.  The adversary chooses which ones, any number of times. *)
let Pairing() =
  in(c, (pk_V: pkey, pk_A: pkey));
  get idV(sk_V, =pk_V) in
  get idA(sk_A, =pk_A) in
  event paired(pk_V, pk_A);
  insert trusted_V(pk_V, pk_A);
  insert trusted_A(pk_V, pk_A).

(* ======================== AUTHENTICATION ========================= *)

let Verifier() =
  in(c, pk_V: pkey);
  get idV(sk_V, =pk_V) in
  get trusted_V(=pk_V, pk_A) in                 (* the paired phone *)
  new x: exponent;
  let eV = exp(g, x) in
  out(c, eV);                                                   (* 1 *)
  in(c, eA: G);                                                 (* 2 *)
  let K = kdf(exp(eA, x), (eV, eA, pk_V, pk_A)) in
  event verifierStarted(pk_V, pk_A, eV, eA);
  out(c, aead(sign((lreq, eV, eA, pk_V, pk_A), sk_V), K));      (* 3 *)
  in(c, m4: bitstring);                                         (* 4 *)
  let sA = aeadDec(m4, K) in
  if verify(sA, pk_A, (lresp, eV, eA, pk_A, pk_V)) then
    event verifierSuccess(pk_V, pk_A, eV, eA);
    new s: bitstring;
    out(c, aead(s, K)).                      (* forward-secrecy probe *)

let Authenticator() =
  in(c, pk_A: pkey);
  get idA(sk_A, =pk_A) in
  in(c, eV: G);                                                 (* 1 *)
  new y: exponent;
  let eA = exp(g, y) in
  out(c, eA);                                                   (* 2 *)
  in(c, m3: bitstring);                                         (* 3 *)
  get trusted_A(pk_V, =pk_A) in          (* trial over paired verifiers *)
  let K = kdf(exp(eV, y), (eV, eA, pk_V, pk_A)) in
  let sV = aeadDec(m3, K) in
  if verify(sV, pk_V, (lreq, eV, eA, pk_V, pk_A)) then
    (* verify first, prompt second: only genuine requests reach the user *)
    event authenticatorPrompted(pk_V, pk_A, eV, eA);
    out(prompt, (pk_V, pk_A, eV, eA));
    in(approval, (=pk_V, =pk_A, =eV, =eA));
    event authenticatorFinished(pk_V, pk_A, eV, eA);
    out(c, aead(sign((lresp, eV, eA, pk_A, pk_V), sk_A), K)).   (* 4 *)

(* The user approves whatever the phone shows: the worst case for fatigue *)
let User() =
  in(prompt, (v: pkey, a: pkey, eV: G, eA: G));
  event userApproved(v, a, eV, eA);
  out(approval, (v, a, eV, eA)).

(* ============================ QUERIES ============================ *)

(* 1. An unlock matches a completed phone session, one-to-one *)
query v: pkey, a: pkey, eV: G, eA: G;
  inj-event(verifierSuccess(v, a, eV, eA)) ==> inj-event(authenticatorFinished(v, a, eV, eA)).

(* 2. The phone completes only sessions a paired verifier started, one-to-one *)
query v: pkey, a: pkey, eV: G, eA: G;
  inj-event(authenticatorFinished(v, a, eV, eA)) ==> inj-event(verifierStarted(v, a, eV, eA)).

(* 3. No replayed or forged request reaches the user: no approval fatigue,
      and no counter needed *)
query v: pkey, a: pkey, eV: G, eA: G;
  inj-event(authenticatorPrompted(v, a, eV, eA)) ==> inj-event(verifierStarted(v, a, eV, eA)).

(* 4. Every unlock is backed by a distinct approval of that very session *)
query v: pkey, a: pkey, eV: G, eA: G;
  inj-event(verifierSuccess(v, a, eV, eA)) ==> inj-event(userApproved(v, a, eV, eA)).

(* 5. Logins happen only between paired devices *)
query v: pkey, a: pkey, eV: G, eA: G;
  event(verifierSuccess(v, a, eV, eA)) ==> event(paired(v, a)).
query v: pkey, a: pkey, eV: G, eA: G;
  event(authenticatorFinished(v, a, eV, eA)) ==> event(paired(v, a)).

(* 6. Forward secrecy of the session key of completed logins:
      reachability (weak) and real-or-random (strong), reported separately *)
query secret s.
query secret s [real_or_random].

process
    ( !RegisterV() | !RegisterA() | !Pairing()
    | !Verifier() | !Authenticator() | !User() )
  | ( phase 1;
      ( (! get idV(skv, pkv) in out(c, skv))
      | (! get idA(ska, pka) in out(c, ska)) ) )
